# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit keys.
#
# The system is provider-agnostic. You only need the key for the provider you actually use.
# Embeddings are LOCAL (sentence-transformers) by default and need no key at all.

# --- Which LLM provider to use for generation: gemini | claude | openai | ollama ---
LLM_PROVIDER=gemini

# --- Gemini (default). Get a free key at https://aistudio.google.com/app/apikey ---
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Claude (optional alternative) ---
# ANTHROPIC_API_KEY=your-anthropic-key-here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (optional alternative) ---
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama (optional, fully local — no key needed, just a running daemon) ---
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434

# --- Local embedding model (no key; downloaded once from the HuggingFace hub) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
